# Kaggle API auth for dataset download -> set via ~/.kaggle/kaggle.json instead of env vars normally,
# but both KAGGLE_USERNAME / KAGGLE_KEY are read by src/data/ingest.py as a fallback.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Where MLflow logs runs
MLFLOW_TRACKING_URI=http://localhost:5000

# Which registry stage FastAPI loads at boot
MODEL_STAGE=Staging

# FastAPI serving port
API_PORT=8000

# Airflow config/dags root
AIRFLOW_HOME=./pipelines
