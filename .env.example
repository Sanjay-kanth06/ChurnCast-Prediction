# ---------------------------------------------------------------- MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=ChurnCast
MLFLOW_MODEL_NAME=ChurnCastModel

# ---------------------------------------------------------------- API
CHURNCAST_API_HOST=127.0.0.1
CHURNCAST_API_PORT=8000
API_URL=http://127.0.0.1:8000

# Comma-separated CORS origins allowed to call the API
CHURNCAST_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------- frontend
# (also set in frontend/.env.local for local `npm run dev`)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------- risk banding
# probability < LOW      -> LOW
# LOW <= p < HIGH        -> MEDIUM
# p >= HIGH              -> HIGH
CHURN_RISK_LOW_THRESHOLD=0.40
CHURN_RISK_HIGH_THRESHOLD=0.70
CHURNCAST_DECISION_THRESHOLD=0.50

# ---------------------------------------------------------------- data
CHURNCAST_SEED=42
CHURNCAST_N_SUBSCRIBERS=7500
# Point this at data/raw_kkbox_original to run against real KKBOX files instead
CHURNCAST_RAW_DIR=data/raw
CHURNCAST_PROCESSED_DIR=data/processed
CHURNCAST_REPORTS_DIR=reports
